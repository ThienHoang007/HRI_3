<?xml version="1.0"?>
<!-- Gripper song song 2 ngón đơn giản gắn vào tool0 của UR3.
     finger_joint: độ mở của MỖI ngón tính từ tâm (0 = khép, 0.04 = mở 8 cm).
     Ngón phải mimic ngón trái. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="simple_gripper" params="parent tf_prefix:=''">

    <material name="gripper_grey"><color rgba="0.3 0.3 0.3 1"/></material>
    <material name="finger_black"><color rgba="0.1 0.1 0.1 1"/></material>

    <joint name="${tf_prefix}gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${tf_prefix}gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${tf_prefix}gripper_base">
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.04 0.11 0.05"/></geometry>
        <material name="gripper_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.04 0.11 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025"/>
        <mass value="0.3"/>
        <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0004"/>
      </inertial>
    </link>

    <xacro:macro name="finger" params="side sign">
      <link name="${tf_prefix}finger_${side}">
        <visual>
          <origin xyz="0 ${sign*0.005} 0.04" rpy="0 0 0"/>
          <geometry><box size="0.02 0.01 0.08"/></geometry>
          <material name="finger_black"/>
        </visual>
        <collision>
          <origin xyz="0 ${sign*0.005} 0.04" rpy="0 0 0"/>
          <geometry><box size="0.02 0.01 0.08"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 0 0.04"/>
          <mass value="0.05"/>
          <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.000005"/>
        </inertial>
      </link>
    </xacro:macro>

    <xacro:finger side="left" sign="1"/>
    <xacro:finger side="right" sign="-1"/>

    <joint name="${tf_prefix}finger_joint" type="prismatic">
      <parent link="${tf_prefix}gripper_base"/>
      <child link="${tf_prefix}finger_left"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="50" velocity="0.1"/>
    </joint>

    <joint name="${tf_prefix}finger_right_joint" type="prismatic">
      <parent link="${tf_prefix}gripper_base"/>
      <child link="${tf_prefix}finger_right"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="50" velocity="0.1"/>
      <mimic joint="${tf_prefix}finger_joint" multiplier="1" offset="0"/>
    </joint>

    <!-- TCP: điểm giữa 2 đầu ngón, nơi vật được kẹp -->
    <joint name="${tf_prefix}gripper_tcp_joint" type="fixed">
      <parent link="${tf_prefix}gripper_base"/>
      <child link="${tf_prefix}gripper_tcp"/>
      <origin xyz="0 0 0.12" rpy="0 0 0"/>
    </joint>
    <link name="${tf_prefix}gripper_tcp"/>

  </xacro:macro>
</robot>
